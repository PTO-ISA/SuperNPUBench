#ifndef SUPERNPU_DYNAMIC_MX_QUANT_TAIL_OCP_FP4_HPP
#define SUPERNPU_DYNAMIC_MX_QUANT_TAIL_OCP_FP4_HPP

#include "quant/dynamic_mx_quant/dynamic_mx_quant_common.hpp"

namespace supernpu::tile_isa::mxquant {

// Tail-axis, OCP scale (scaleAlg=0), FP4 output (E2M1 default, E1M2 valid).
// emax derived from OutT (fp4_e2m1 -> 0x0100). Two-pass (full + M_tail) structure
// mirrors dynamic_mx_quant_tail_cublas_fp8: everything is inlined, the tail is an
// `if constexpr (M_tail>0)` block with M_tail baked into the tile aliases.
//
// ALIGNMENT/PACKING (RECORD.md 问题2): a single MX block of fp4 output is
// BlockSize/2 packed bytes (16B at BlockSize=32), which fails the 32B column
// alignment (pto_tile.hpp:408) whenever BlockSize/2 % 32 != 0. The pack axis
// (halved cols) COINCIDES with the reduce axis, so we cannot widen the physical
// tile to merge blocks (that would merge two blocks into one TROWMAX). Instead we
// DECOUPLE reduce from pack for EVERY BlockSize: reduce each BlockSize-col block
// independently (own scale/recip, TROWEXPANDMUL to fp32), TSTORE the two
// [TileM,BlockSize] fp32 results into the two column halves of a scratch-HBM
// buffer, TLOAD the [TileM,2*BlockSize] fp32 tile, and emit ONE fp32->fp4 TCVT of
// width BlockSize (= 2*BlockSize fp4 = BlockSize packed bytes, 32B-aligned for any
// BlockSize % 32 == 0). An ODD trailing block (numKb odd) is handled AscendC-style
// (dynamic_mx_quant_tail_axis.h:350): a same-shape zero tile is synthesized for the
// missing block and run through the identical scale/data path (0*recip == 0, no
// NaN — OCP clamps max=0 up to emax so recip stays finite), its E8M0 byte lands in
// the even-aligned padding scale slot, and the packed output is narrowed (valid-col
// box to BlockSize/2) so only the single real block (N/2 bytes/row) is written.
// -> needs only N % BlockSize == 0.
template <int M, int N, int TileM = 8, int BlockSize = 32, typename OutT = __fp4_e2m1x2>
void dynamic_mx_quant_tail_ocp_fp4(__bf16 *x, OutT *y, uint8_t *scale) {
    static_assert(M > 0 && N > 0, "dim must be positive");
    static_assert(N % BlockSize == 0, "N must be multiple of BlockSize");
    static_assert(BlockSize % 32 == 0,
                  "fp4 tail packs 2 MX blocks (2*BlockSize fp4 = BlockSize packed "
                  "bytes) per output tile; BlockSize must be a multiple of 32 so the "
                  "packed width is 32B-column-aligned (pto_tile.hpp:408)");

    using namespace pto;

    constexpr int full_m = M / TileM;
    constexpr int M_tail = M % TileM;
    constexpr int numKb  = N / BlockSize;
    // AscendC scale layout: uint8 E8M0, one byte per block, compact [M, scaleCols]
    // with the block count even-aligned. Mirrors dynamic_mx_quant_tail_axis.h:217.
    constexpr int scaleCols = ((numKb + 1) / 2) * 2;
    constexpr int  numPair = (numKb + 1) / 2;   // CeilDiv(numKb, 2)
    constexpr bool oddTail = (numKb % 2) != 0;   // last pair carries a zero block

    uint8_t *y_u8 = reinterpret_cast<uint8_t *>(y);

    using gm_x  = global_tensor<__bf16,   RowMajor<M, N>>;
    using gm_xu = global_tensor<uint16_t, RowMajor<M, N>>;
    using gm_y  = global_tensor<uint8_t,  RowMajor<M, N / 2>>;
    using gm_s  = global_tensor<uint8_t,  RowMajor<M, scaleCols>>;

    // Scratch-HBM concat buffer: two [TileM,BlockSize] fp32 halves -> one
    // [TileM,2*BlockSize] fp32 tile. Physical rows stay TileM in both passes.
    static float cat_buf[TileM * 2 * BlockSize] __attribute__((aligned(4096)));
    using gm_cat = global_tensor<float, RowMajor<TileM, 2 * BlockSize>>;

    // Full-tile pass (ValidRow == TileM; boxed types collapse to NoneBox).
    {
        using tile_x         = Tile<Location::Vec, __bf16,   TileM, BlockSize, BLayout::RowMajor>;
        using tile_xu        = Tile<Location::Vec, uint16_t, TileM, BlockSize, BLayout::RowMajor>;
        using tile_sred      = Tile<Location::Vec, uint16_t, TileM, BlockSize, BLayout::RowMajor, TileM, 1>;
        using tile_sstore    = Tile<Location::Vec, uint8_t,  TileM, BlockSize, BLayout::RowMajor, TileM, 1>;
        using tile_recip_bf1 = Tile<Location::Vec, __bf16,   TileM, BlockSize, BLayout::RowMajor, TileM, 1>;
        using tile_recip_f1  = Tile<Location::Vec, float,    TileM, BlockSize, BLayout::RowMajor, TileM, 1>;
        using tile_half      = Tile<Location::Vec, float,    TileM, BlockSize, BLayout::RowMajor>;
        using tile_cat       = Tile<Location::Vec, float,    TileM, 2 * BlockSize, BLayout::RowMajor>;
        using tile_o         = Tile<Location::Vec, OutT,     TileM, BlockSize, BLayout::RowMajor>;
        using tile_o_half    = Tile<Location::Vec, OutT,     TileM, BlockSize, BLayout::RowMajor, TileM, BlockSize / 2>;

        global_iterator<gm_x,  tile_x>  x_iter(x);
        global_iterator<gm_xu, tile_xu> xu_iter(reinterpret_cast<uint16_t *>(x));
        global_iterator<gm_y,  tile_o>  y_iter(y_u8);

        for (int m = 0; m < full_m; ++m) {
            for (int p = 0; p < numPair; ++p) {
                global_iterator<gm_cat, tile_half> c_iter(cat_buf);
                for (int b = 0; b < 2; ++b) {
                    int kb = 2 * p + b;
                    bool zeroBlk = (kb >= numKb);
                    // Compact scale: base pointer folds the block index (kb);
                    // the iterator j-stride is the PHYSICAL tile width, not 1.
                    global_iterator<gm_s, tile_sstore> s_iter(scale + kb);
                    auto gs = s_iter(m, 0);

                    tile_sred scale_byte;
                    tile_sred recip;
                    tile_xu x_u16;
                    if (zeroBlk) {
                        TEXPANDS(x_u16, static_cast<uint16_t>(0));
                    } else {
                        auto gxu = xu_iter(m, kb);
                        TLOAD(x_u16, gxu);
                    }
                    compute_ocp_scale_tail_boxed<OutT, TileM, BlockSize>(x_u16, scale_byte, recip);
                    tile_sstore scale_u8;
                    TCVT(scale_u8, scale_byte);
                    TSTORE(gs, scale_u8);

                    tile_recip_bf1 inv_bf16;
                    // WORKAROUND: 寄存器级 reinterpret 未支持，经 HBM 字节别名规避，详见 RECORD.md 问题4
                    reinterpret_u16_to_bf16<2, TileM, BlockSize, TileM, 1>(recip, inv_bf16);
                    tile_recip_f1 inv_scale_f;
                    TCVT(inv_scale_f, inv_bf16);

                    tile_half xf;
                    if (zeroBlk) {
                        // Zero the data half directly in fp32. A bf16 TEXPANDS
                        // immediate crashes the LinxV5 backend (illegal type in
                        // inline asm), and 0 * inv_scale == 0 anyway, so
                        // synthesize the zero block's fp32 result as 0.
                        TEXPANDS(xf, 0.0f);
                    } else {
                        tile_x xq;
                        auto gx = x_iter(m, kb);
                        TLOAD(xq, gx);
                        TCVT(xf, xq);
                        TROWEXPANDMUL(xf, xf, inv_scale_f); // per-row scalar broadcast-mul
                    }
                    auto gc = c_iter(0, b);             // column-half b of cat_buf
                    TSTORE(gc, xf);
                }

                // Widen to 2*BlockSize fp32, single fp32 -> packed fp4. For an odd
                // trailing pair, narrow the store to the one real block (N/2 bytes).
                tile_cat xcat;
                global_iterator<gm_cat, tile_cat> cr_iter(cat_buf);
                auto gcr = cr_iter(0, 0);
                TLOAD(xcat, gcr);
                bool narrow = false;
                if constexpr (oddTail) narrow = (p == numPair - 1);
                if (narrow) {
                    tile_o_half oq;
                    TCVT(oq, xcat);
                    global_iterator<gm_y, tile_o_half> yh_iter(y_u8);
                    auto gy = yh_iter(m, p);
                    TSTORE(gy, oq);
                } else {
                    tile_o oq;
                    TCVT(oq, xcat);
                    auto gy = y_iter(m, p);
                    TSTORE(gy, oq);
                }
            }
        }
    }

    // Tail rows: M_tail (< TileM), boxed to ValidRow = M_tail; row block full_m.
    if constexpr (M_tail > 0) {
        using tile_x         = Tile<Location::Vec, __bf16,   TileM, BlockSize, BLayout::RowMajor, M_tail, BlockSize>;
        using tile_xu        = Tile<Location::Vec, uint16_t, TileM, BlockSize, BLayout::RowMajor, M_tail, BlockSize>;
        using tile_sred      = Tile<Location::Vec, uint16_t, TileM, BlockSize, BLayout::RowMajor, M_tail, 1>;
        using tile_sstore    = Tile<Location::Vec, uint8_t,  TileM, BlockSize, BLayout::RowMajor, M_tail, 1>;
        using tile_recip_bf1 = Tile<Location::Vec, __bf16,   TileM, BlockSize, BLayout::RowMajor, M_tail, 1>;
        using tile_recip_f1  = Tile<Location::Vec, float,    TileM, BlockSize, BLayout::RowMajor, M_tail, 1>;
        using tile_half      = Tile<Location::Vec, float,    TileM, BlockSize, BLayout::RowMajor, M_tail, BlockSize>;
        using tile_cat       = Tile<Location::Vec, float,    TileM, 2 * BlockSize, BLayout::RowMajor, M_tail, 2 * BlockSize>;
        using tile_o         = Tile<Location::Vec, OutT,     TileM, BlockSize, BLayout::RowMajor, M_tail, BlockSize>;
        using tile_o_half    = Tile<Location::Vec, OutT,     TileM, BlockSize, BLayout::RowMajor, M_tail, BlockSize / 2>;

        global_iterator<gm_x,  tile_x>  x_iter(x);
        global_iterator<gm_xu, tile_xu> xu_iter(reinterpret_cast<uint16_t *>(x));
        global_iterator<gm_y,  tile_o>  y_iter(y_u8);

        for (int p = 0; p < numPair; ++p) {
            global_iterator<gm_cat, tile_half> c_iter(cat_buf);
            for (int b = 0; b < 2; ++b) {
                int kb = 2 * p + b;
                bool zeroBlk = (kb >= numKb);
                global_iterator<gm_s, tile_sstore> s_iter(scale + kb);
                auto gs = s_iter(full_m, 0);

                tile_sred scale_byte;
                tile_sred recip;
                tile_xu x_u16;
                if (zeroBlk) {
                    TEXPANDS(x_u16, static_cast<uint16_t>(0));
                } else {
                    auto gxu = xu_iter(full_m, kb);
                    TLOAD(x_u16, gxu);
                }
                compute_ocp_scale_tail_boxed<OutT, TileM, BlockSize, M_tail>(x_u16, scale_byte, recip);
                tile_sstore scale_u8;
                TCVT(scale_u8, scale_byte);
                TSTORE(gs, scale_u8);

                tile_recip_bf1 inv_bf16;
                // WORKAROUND: 寄存器级 reinterpret 未支持，经 HBM 字节别名规避，详见 RECORD.md 问题4
                reinterpret_u16_to_bf16<2, TileM, BlockSize, M_tail, 1>(recip, inv_bf16);
                tile_recip_f1 inv_scale_f;
                TCVT(inv_scale_f, inv_bf16);

                tile_half xf;
                if (zeroBlk) {
                    // Zero the data half directly in fp32 (see full-pass note):
                    // bf16 TEXPANDS immediate crashes the LinxV5 backend, and
                    // 0 * inv_scale == 0, so synthesize the fp32 result as 0.
                    TEXPANDS(xf, 0.0f);
                } else {
                    tile_x xq;
                    auto gx = x_iter(full_m, kb);
                    TLOAD(xq, gx);
                    TCVT(xf, xq);
                    TROWEXPANDMUL(xf, xf, inv_scale_f);
                }
                auto gc = c_iter(0, b);
                TSTORE(gc, xf);
            }

            tile_cat xcat;
            global_iterator<gm_cat, tile_cat> cr_iter(cat_buf);
            auto gcr = cr_iter(0, 0);
            TLOAD(xcat, gcr);
            bool narrow = false;
            if constexpr (oddTail) narrow = (p == numPair - 1);
            if (narrow) {
                tile_o_half oq;
                TCVT(oq, xcat);
                global_iterator<gm_y, tile_o_half> yh_iter(y_u8);
                auto gy = yh_iter(full_m, p);
                TSTORE(gy, oq);
            } else {
                tile_o oq;
                TCVT(oq, xcat);
                auto gy = y_iter(full_m, p);
                TSTORE(gy, oq);
            }
        }
    }
}

} // namespace supernpu::tile_isa::mxquant

#endif
