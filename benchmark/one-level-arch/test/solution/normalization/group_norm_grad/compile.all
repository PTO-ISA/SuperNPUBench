#!/bin/bash
# Dynamic 4PE GroupNormGrad N=1,C=64,G=8,HxW=1024; tiling is calculated from runtime shape.
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the compiler bin directory}"
make TESTCASE=group_norm_grad COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=1 C_CH=64 G_GRP=8 HxW_SZ=1024 PE_NUM=4 diss
