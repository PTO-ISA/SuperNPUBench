#!/bin/bash
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the compiler bin directory}"

# Dynamic 4PE GroupNormGrad N=2,C=32,G=8,HxW=2048; tiling is calculated from runtime shape.
make TESTCASE=group_norm_grad_dynamic COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=2 C_CH=32 G_GRP=8 HxW_SZ=2048 PE_NUM=4 diss

# Fixed-shape static 4PE counterpart.
make TESTCASE=group_norm_grad_static COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=2 C_CH=32 G_GRP=8 HxW_SZ=2048 PE_NUM=4 diss

# Dynamic 4PE GroupNormGrad1D (HxW == 1) N=256,C=4096,G=8,D=512; tiling is calculated from runtime shape.
make TESTCASE=group_norm_grad_1d_dynamic COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=256 C_CH=4096 G_GRP=8 PE_NUM=4 diss

# Fixed-shape static 4PE counterpart.
make TESTCASE=group_norm_grad_1d_static COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=256 C_CH=4096 G_GRP=8 PE_NUM=4 diss
