#!/bin/bash
# Dynamic 4PE RMSNorm [512,8192]; tiling is calculated from runtime shape.
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the compiler bin directory}"
make TESTCASE=rms_norm_dynamic COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=512 G_R=8192 PE_NUM=4 diss

# Fixed-shape static 4PE counterpart.
make TESTCASE=rms_norm_static COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=512 G_R=8192 PE_NUM=4 diss

# Static SIMT: pair outer-R blocks and assemble eight [32,1] reductions into [32,8].
make TESTCASE=rms_norm_simt_static_m_R_tree COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=512 G_R=8192 PE_NUM=4 diss
