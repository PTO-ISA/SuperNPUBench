#!/bin/bash
# Dynamic 4PE RMSNorm [128,8192]; tiling is calculated from runtime shape.
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the compiler bin directory}"
make TESTCASE=rms_norm_dynamic COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=128 G_R=8192 PE_NUM=4 diss

# Fixed-shape static 4PE counterpart.
make TESTCASE=rms_norm_static COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=128 G_R=8192 PE_NUM=4 diss

# Static SIMT: pair outer-R blocks.

# Static SIMT: reduce 32 M rows independently through a three-level R tree.

# Dynamic SIMT R-tree with runtime shape and tiling.
make TESTCASE=rms_norm_dynamic_m_R_tree DType=__half G_A=128 G_R=8192 PE_NUM=4 diss
make TESTCASE=rms_norm_dynamic_m_R_simt COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=128 G_R=8192 PE_NUM=4 diss

# 32 KiB FP32 data tiles: one-block and paired-block R coverage.
for testcase in rms_norm_dynamic_m_R_simt_32k rms_norm_dynamic_m_R_tree_32k; do
    for reduce_size in 8192 16384; do
        make TESTCASE="$testcase" COMPILER_DIR="$COMPILER_DIR" DType=__half G_A=128 G_R="$reduce_size" PE_NUM=4 diss
    done
done
