#!/bin/bash
set -euo pipefail
# Original FP8 configurations. Inputs are generated per configuration and
# linked by symbol; PYTHON must provide the existing numpy/ml_dtypes prerequisites.
: "${PYTHON:=python3}"
"$PYTHON" -c 'import ml_dtypes, numpy'
export PYTHON

# ============ 关键 Case 1：单 chunk，多 token，全量 topK ============
make -B TESTCASE=qli_check_opt QLI_DTYPE=FP8 Sq=64 Skv=128 topk=128

# ============ 关键 Case 2：单 chunk，大 Skv，大 topK ============
make -B TESTCASE=qli_check_opt QLI_DTYPE=FP8 Sq=4 Skv=2048 topk=512

# ============ 关键 Case 3：4 chunk 大规模 ============
make -B TESTCASE=qli_check_opt QLI_DTYPE=FP8 Sq=4 Skv=8192 topk=512

# ============ 关键 Case 4：tail chunk（Skv%2048=32，Skv%kTk=0） ============
make -B TESTCASE=qli_check_opt QLI_DTYPE=FP8 Sq=4 Skv=2080 topk=512
