#!/bin/bash
# MegaMoe A8W8 — sim (single-PE) / sim_mt (true 4-PE) / sim_mt_dyn (true 4-PE
# dynamic-shape) compile entries.
# Simulation keeps the small 16x32x64 spec (gfsim verified);
# the A5 cann-samples mega_moe_story uses the same spec for perf comparison.
# Run the _mt / _mt_dyn ELF with: gfrun -t 1 -s softcore.multiThreadNum=4 -f <elf>

: "${COMPILER_DIR:?Set COMPILER_DIR to the in-repo Linx compiler bin directory}"

make TESTCASE=mega_moe_sim BS=16 H=32 HIDDEN=64 COMPILER_DIR="$COMPILER_DIR" diss
make TESTCASE=mega_moe_sim_mt BS=16 H=32 HIDDEN=64 COMPILER_DIR="$COMPILER_DIR" diss
make TESTCASE=mega_moe_sim_mt_dyn BS=16 H=32 HIDDEN=64 COMPILER_DIR="$COMPILER_DIR" diss
