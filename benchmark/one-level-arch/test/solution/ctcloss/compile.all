#!/usr/bin/env bash
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the Linx toolchain bin directory}"
: "${API_INCLUDE:?Set API_INCLUDE to the pinned TileOP include directory}"
if [[ -n "${CTC_PE_NUM:-}" && "$CTC_PE_NUM" != 1 && "$CTC_PE_NUM" != 4 ]]; then
    echo "CTC_PE_NUM must be 1 or 4" >&2
    exit 2
fi
cd "$(dirname "$0")"
for entry in ctcloss_v2_single_pe:1 ctcloss_v2_four_pe:4; do
    testcase="${entry%%:*}"
    pe="${entry##*:}"
    if [[ -n "${CTC_PE_NUM:-}" && "$pe" != "$CTC_PE_NUM" ]]; then continue; fi
    extra=()
    if [[ -n "${CTC_COMPARE_ROOT:-}" ]]; then
        extra+=("CHK_DIR=$CTC_COMPARE_ROOT/pe$pe/compare")
    fi
    # The shared Makefile has an implicit clean prerequisite. Suppress it and
    # explicitly rebuild this TU for changes in flags, CHK_DIR or res_check.
    make -o clean -W "$PWD/src/$testcase.cpp" TESTCASE="$testcase" \
        COMPILER_DIR="$COMPILER_DIR" API_INCLUDE="$API_INCLUDE" DType=float \
        PE_NUM="$pe" res_check="${res_check:-on}" "${extra[@]}" "$@" diss
done
