#!/bin/bash
# matmul_test — 4-PE cooperative fp16 GEMM (A Local CellReg / B Shared).
#
# Run: gfrun -t 1 -f <elf>   (model defaults to 4 PEs)
# Tiles must be powers of two (model constraint).
# M/N are zero-padded to tile multiples; K must be divisible by tK.

set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the in-repo Linx compiler bin directory}"

make TESTCASE=matmul_test COMPILER_DIR="$COMPILER_DIR" \
    B=1 M=160 N=320 K=1536 tM=64 tN=256 tK=128 diss

make TESTCASE=matmul_test COMPILER_DIR="$COMPILER_DIR" \
    B=1 M=120 N=256 K=1536 tM=128 tN=128 tK=128 diss

make TESTCASE=matmul_test COMPILER_DIR="$COMPILER_DIR" \
    B=1 M=120 N=192 K=1536 tM=128 tN=128 tK=128 diss
