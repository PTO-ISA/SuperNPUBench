#!/bin/bash
# MoE Dispatch — single-PE V2 + 4-PE SPMD + 4-PE dynamic-shape compile tests.
# Run the _mt / _mt_dyn ELFs with: gfrun -t 1 -s softcore.multiThreadNum=4 -f <elf>

: "${COMPILER_DIR:?Set COMPILER_DIR to the in-repo Linx compiler bin directory}"

make TESTCASE=moe_dispatch_v2 COMPILER_DIR="$COMPILER_DIR" diss
make TESTCASE=moe_dispatch_mt COMPILER_DIR="$COMPILER_DIR" diss
make TESTCASE=moe_dispatch_mt_dyn COMPILER_DIR="$COMPILER_DIR" diss
