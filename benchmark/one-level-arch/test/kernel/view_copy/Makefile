ifeq ($(TESTCASE), view_copy)
INPUT_STORAGE_ELEMENTS ?= $(ELEMENTS)
OUTPUT_STORAGE_ELEMENTS ?= $(ELEMENTS)
ABS_TOL ?= 0.001f
REL_TOL ?= 0.001f

DEFINES += -DDType=$(DType) \
	-DRANKs=$(RANK) \
	-DELEMENTSs=$(ELEMENTS) \
	-DTILE_ELEMENTSs=$(TILE_ELEMENTS) \
	-DSHAPEs=$(SHAPE) \
	-DINPUT_GLOBAL_STRIDEs=$(INPUT_GLOBAL_STRIDE) \
	-DOUTPUT_GLOBAL_STRIDEs=$(OUTPUT_GLOBAL_STRIDE) \
	-DINPUT_OFFSET_BYTESs=$(INPUT_OFFSET_BYTES) \
	-DOUTPUT_OFFSET_BYTESs=$(OUTPUT_OFFSET_BYTES) \
	-DINPUT_STORAGE_ELEMENTSs=$(INPUT_STORAGE_ELEMENTS) \
	-DOUTPUT_STORAGE_ELEMENTSs=$(OUTPUT_STORAGE_ELEMENTS) \
	-DABS_TOLs=$(ABS_TOL) \
	-DREL_TOLs=$(REL_TOL)
TARGET = $(ELF_HEAD)_$(TESTCASE)_DType$(DType)_SHAPE$(SHAPE_NAME)_TILE$(TILE_ELEMENTS)_IN_STRIDE$(INPUT_GLOBAL_STRIDE_NAME)_OUT_STRIDE$(OUTPUT_GLOBAL_STRIDE_NAME).elf
endif

SRC_FILE += $(TEST_ROOT)/$(CASE_SRC_DIR)/$(TESTCASE).cpp
include ../../common/Makefile.common
