#!/bin/bash
# Dynamic 4PE GroupNormGrad1D N=512,C=64,G=8,D=8; tiling is calculated from runtime shape.
set -euo pipefail
: "${COMPILER_DIR:?Set COMPILER_DIR to the compiler bin directory}"
make TESTCASE=group_norm_grad_1d COMPILER_DIR="$COMPILER_DIR" DType=__half N_BATCH=512 C_CH=64 G_GRP=8 PE_NUM=4 diss
