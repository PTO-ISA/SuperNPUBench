#!/bin/bash
# GroupNorm Grad HxW==1: fp16; shape N=8 C=64 G=8 (D=8)

set -euo pipefail

: "${COMPILER_DIR:?Set COMPILER_DIR to the linx_blockisa_llvm_musl bin directory}"

make TESTCASE=group_norm_grad_1d COMPILER_DIR="$COMPILER_DIR" \
  DType=__half N_BATCH=8 C_CH=64 G_GRP=8 TILE_D=-1 diss

# Same dynamic entry, one kernel call; PE partitioning is internal.
make TESTCASE=group_norm_grad_1d COMPILER_DIR="$COMPILER_DIR" \
  DType=__half N_BATCH=8 C_CH=64 G_GRP=8 TILE_D=-1 PE_NUM=4 diss

# Static Valid; tile_d=-1 → D=C/G=8
make TESTCASE=group_norm_grad_1d_static COMPILER_DIR="$COMPILER_DIR" \
  DType=__half N_BATCH=8 C_CH=64 G_GRP=8 TILE_D=8 diss

make TESTCASE=group_norm_grad_1d_static COMPILER_DIR="$COMPILER_DIR" \
  DType=__half N_BATCH=8 C_CH=64 G_GRP=8 TILE_D=8 PE_NUM=4 diss

