#!/bin/bash
# RMSNorm binary-accumulate: [1,8192] fp16, tile_r=1024, pow_r=4096
set -euo pipefail

: "${COMPILER_DIR:?Set COMPILER_DIR to the linx_blockisa_llvm_musl bin directory}"

make TESTCASE=rms_norm_binary COMPILER_DIR="$COMPILER_DIR" DType=__half diss

# Static Valid; same [1,8192] tile_r=1024 pow_r=4096
make TESTCASE=rms_norm_binary_static COMPILER_DIR="$COMPILER_DIR" DType=__half \
  G_A=1 G_R=8192 TILE_A=1 TILE_R=1024 POW_R=4096 diss


# 4PE: split four independent rows across PEs inside the kernel.
make TESTCASE=rms_norm_binary COMPILER_DIR="$COMPILER_DIR" DType=__half \
  G_A=4 G_R=8192 TILE_A=1 TILE_R=1024 POW_R=4096 PE_NUM=4 diss
make TESTCASE=rms_norm_binary_static COMPILER_DIR="$COMPILER_DIR" DType=__half \
  G_A=4 G_R=8192 TILE_A=1 TILE_R=1024 POW_R=4096 PE_NUM=4 diss
