#!/bin/bash
# export COMPILER_DIR=/path/to/linx_blockisa_llvm_musl/bin; ./compile.all;
# python3 src/run_topk_check.py --gfrun /path/to/gfrun
set -euo pipefail

: "${COMPILER_DIR:?Set COMPILER_DIR to the Linx compiler bin directory}"

for testcase in topk; do
    make TESTCASE="$testcase" COMPILER_DIR="$COMPILER_DIR" res_check=on diss
done
