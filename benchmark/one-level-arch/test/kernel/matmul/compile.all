#!/bin/bash
# Matmul operator test cases
#
# Supported TYPE values:
#   - HIF4_HIF4: FP4 x FP4 matmul with microscaling factors
#   - A16W4: BF16 x FP4 mixed precision matmul
#   - MASK: Generic matmul with various data types
#
# Supported VER values (for HIF4_HIF4):
#   - BASE: Default implementation with gather
#   - MX_NOGATHER: Implementation without gather
#   - MX_NOGATHER_REUSEA: Optimized version with A tile reuse

# ============================================
# HIF4_HIF4: FP4 x FP4 matmul (BASE) - 6 configs
# ============================================
# mgather版本，已弃用
#make TESTCASE=matmul TYPE=HIF4_HIF4 M=256 N=2048 K=2048 tM=32 tN=32 tK=64
#make TESTCASE=matmul TYPE=HIF4_HIF4 M=256 N=2048 K=2048 tM=32 tN=32 tK=64
#make TESTCASE=matmul TYPE=HIF4_HIF4 M=512 N=1280 K=4096 tM=32 tN=32 tK=64
#make TESTCASE=matmul TYPE=HIF4_HIF4 M=512 N=1280 K=4096 tM=32 tN=32 tK=64

# ============================================
# HIF4_HIF4: MX_NOGATHER variant - 2 configs
# ============================================
make TESTCASE=matmul TYPE=HIF4_HIF4 VER=MX_NOGATHER M=256 N=2048 K=2048 tM=32 tN=32 tK=64
make TESTCASE=matmul TYPE=HIF4_HIF4 VER=MX_NOGATHER M=512 N=1280 K=4096 tM=32 tN=32 tK=64

# ============================================
# HIF4_HIF4: MX_NOGATHER_REUSEA variant - 2 configs
# ============================================
make TESTCASE=matmul TYPE=HIF4_HIF4 VER=MX_NOGATHER_REUSEA M=256 N=2048 K=2048 tM=32 tN=32 tK=64
# Keep the fully-unrolled reuse-A frame below the backend's 64 KiB register
# frame limit. The former M=512,K=4096 case hit eliminateFrameIndex's RegSize
# assertion; this still covers the non-square N=1280 path at a safe extent.
make TESTCASE=matmul TYPE=HIF4_HIF4 VER=MX_NOGATHER_REUSEA M=256 N=1280 K=2048 tM=32 tN=32 tK=64

# ============================================
# A16W4: BF16 x FP4 mixed precision - 3 configs
# ============================================
make TESTCASE=matmul TYPE=A16W4 M=256 N=2048 K=2048 tM=16 tN=16 tK=128
make TESTCASE=matmul TYPE=A16W4 M=512 N=1280 K=2048 tM=16 tN=16 tK=128
make TESTCASE=matmul TYPE=A16W4 M=512 N=512 K=4096 tM=16 tN=16 tK=128

# ============================================
# MASK: Generic matmul variants - 8 configs
# ============================================
# FP32 variants
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP32 M=256 N=256 K=256 tM=32 tN=32 tK=32
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP32_REUSEA M=256 N=256 K=256 tM=32 tN=32 tK=32
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP32_REUSEB M=256 N=256 K=256 tM=32 tN=32 tK=32
# 黄区能过，蓝区过不了
# make TESTCASE=matmul TYPE=MASK MODE=MASK_FP32_DYNAMIC M=256 N=256 K=256 tM=32 tN=32 tK=32

# FP16 variants
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP16 M=256 N=256 K=256 tM=32 tN=32 tK=64
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP16_REUSEA M=256 N=256 K=256 tM=32 tN=32 tK=64
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP16_REUSEB M=256 N=256 K=256 tM=32 tN=32 tK=64

# FP8 variants
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP8 M=256 N=256 K=256 tM=32 tN=32 tK=64
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP8_REUSEA M=256 N=256 K=256 tM=32 tN=32 tK=64
make TESTCASE=matmul TYPE=MASK MODE=MASK_FP8_REUSEB M=256 N=256 K=256 tM=32 tN=32 tK=64
# make TESTCASE=matmul TYPE=MASK MODE=MX_FP8 M=256 N=256 K=256 tM=32 tN=32 tK=64

# ============================================
# MATMUL_TEST: Dynamic-shape FP16 matmul (one ELF per tile config;
# gM/gN/gK read from shape.txt at runtime)
#   self_verify=on : in-kernel all-1 check, return code = mismatch count
#   res_check=on   : file-based, host-side golden compare via gfrun_matmul.py
# ============================================
# SELF_VERIFY (tM=16 tN=16 tK=16)
make TESTCASE=matmul TYPE=MATMUL_TEST tM=16 tN=16 tK=16 self_verify=on
# SELF_VERIFY (tM=32 tN=32 tK=64), full check
make TESTCASE=matmul TYPE=MATMUL_TEST tM=32 tN=32 tK=64 self_verify=on verify_elems=65535
# RES_CHECK (tM=16 tN=16 tK=16)
make TESTCASE=matmul TYPE=MATMUL_TEST tM=16 tN=16 tK=16 res_check=on
# RES_CHECK (tM=32 tN=32 tK=64)
make TESTCASE=matmul TYPE=MATMUL_TEST tM=32 tN=32 tK=64 res_check=on
