#!/bin/bash
set -u
echo "=== scalar ==="
failures=()
run_case() {
  local testcase=$1
  echo "  $testcase"
  if make TESTCASE="$testcase" diss; then
    echo "PASS: $testcase"
  else
    echo "FAIL: $testcase"
    failures+=("$testcase")
  fi
}
run_case abs_f64_lat
run_case abs_f64_thr
run_case abs_fp32_lat
run_case abs_fp32_thr
run_case abs_i32_lat
run_case abs_i32_thr
run_case add_f64_lat
run_case add_f64_thr
run_case add_fp32_lat
run_case add_fp32_thr
run_case add_i32_lat
run_case add_i32_thr
run_case add_i64_lat
run_case add_i64_thr
run_case and_i32_lat
run_case and_i32_thr
run_case and_i64_lat
run_case and_i64_thr
run_case clz_i32_lat
run_case clz_i32_thr
run_case clz_i64_lat
run_case clz_i64_thr
run_case div_f64_lat
run_case div_f64_thr
run_case div_fp32_lat
run_case div_fp32_thr
run_case div_i32_lat
run_case div_i32_thr
run_case div_i64_lat
run_case div_i64_thr
run_case f2f_narrow_f64_to_fp32_thr
run_case f2f_widen_fp32_to_f64_thr
run_case f2i_f64_to_i32_thr
run_case f2i_fp32_to_i32_thr
run_case i2f_i32_to_f64_thr
run_case i2f_i32_to_fp32_thr
run_case ld_f64_thr
run_case ld_fp32_thr
run_case ld_i32_thr
run_case ld_i64_thr
run_case max_f64_lat
run_case max_f64_thr
run_case max_fp32_lat
run_case max_fp32_thr
run_case max_i32_lat
run_case max_i32_thr
run_case max_i64_lat
run_case max_i64_thr
run_case min_f64_lat
run_case min_f64_thr
run_case min_fp32_lat
run_case min_fp32_thr
run_case min_i32_lat
run_case min_i32_thr
run_case min_i64_lat
run_case min_i64_thr
run_case mod_i32_lat
run_case mod_i32_thr
run_case mod_i64_lat
run_case mod_i64_thr
run_case mul_f64_lat
run_case mul_f64_thr
run_case mul_fp32_lat
run_case mul_fp32_thr
run_case mul_i32_lat
run_case mul_i32_thr
run_case mul_i64_lat
run_case mul_i64_thr
run_case neg_f64_lat
run_case neg_f64_thr
run_case neg_fp32_lat
run_case neg_fp32_thr
run_case neg_i32_lat
run_case neg_i32_thr
run_case neg_i64_lat
run_case neg_i64_thr
run_case not_i32_lat
run_case not_i32_thr
run_case not_i64_lat
run_case not_i64_thr
run_case or_i32_lat
run_case or_i32_thr
run_case or_i64_lat
run_case or_i64_thr
run_case popc_i32_lat
run_case popc_i32_thr
run_case popc_i64_lat
run_case popc_i64_thr
run_case sll_i32_lat
run_case sll_i32_thr
run_case sll_i64_lat
run_case sll_i64_thr
run_case slt_i32_lat
run_case slt_i32_thr
run_case slt_i64_lat
run_case slt_i64_thr
run_case sqrt_f64_lat
run_case sqrt_f64_thr
run_case sqrt_fp32_lat
run_case sqrt_fp32_thr
run_case sra_i32_lat
run_case sra_i32_thr
run_case sra_i64_lat
run_case sra_i64_thr
run_case srl_i32_lat
run_case srl_i32_thr
run_case srl_i64_lat
run_case srl_i64_thr
run_case st_f64_thr
run_case st_fp32_thr
run_case st_i32_thr
run_case st_i64_thr
run_case sub_f64_lat
run_case sub_f64_thr
run_case sub_fp32_lat
run_case sub_fp32_thr
run_case sub_i32_lat
run_case sub_i32_thr
run_case sub_i64_lat
run_case sub_i64_thr
run_case xor_i32_lat
run_case xor_i32_thr
run_case xor_i64_lat
run_case xor_i64_thr
if [ "${#failures[@]}" -ne 0 ]; then
  echo "=== scalar FAILED: ${failures[*]} ==="
  exit 1
fi
echo "=== scalar completed: all 124 cases passed ==="
