#!/bin/bash
set -u
echo "=== vector ==="
failures=()
run_case() {
  local testcase=$1
  echo "  $testcase"
  if make TESTCASE="$testcase" diss; then
    echo "PASS: $testcase"
  else
    echo "FAIL: $testcase"
    failures+=("$testcase")
  fi
}
run_case tabs_fp16_16x16
run_case tabs_fp32_16x16
run_case tadd_fp16_16x16
run_case tadd_fp32_16x16
run_case tadd_i16_16x16
