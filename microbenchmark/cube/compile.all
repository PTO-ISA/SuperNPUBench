#!/bin/bash
set -u
echo "=== cube ==="
failures=()
run_case() {
  local testcase=$1
  echo "  $testcase"
  if make TESTCASE="$testcase" diss; then
    echo "PASS: $testcase"
  else
    echo "FAIL: $testcase"
    failures+=("$testcase")
  fi
}
run_case tmatmul_acc_bf16_32x64x64
run_case tmatmul_acc_fp16_32x64x64
run_case tmatmul_acc_fp32_32x32x32
run_case tmatmul_bf16_32x64x64
run_case tmatmul_bias_bf16_32x64x64
run_case tmatmul_bias_fp16_32x64x64
run_case tmatmul_bias_fp32_32x32x32
run_case tmatmul_fp16_16x32x32
run_case tmatmul_fp16_32x64x64
run_case tmatmul_fp32_32x32x32
run_case tmatmul_i8_32x64x64
if [ "${#failures[@]}" -ne 0 ]; then
  echo "=== cube FAILED: ${failures[*]} ==="
  exit 1
fi
echo "=== cube completed: all 11 cases passed ==="
