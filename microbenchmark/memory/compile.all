#!/bin/bash
set -u
echo "=== memory ==="
failures=()
run_case() {
  local testcase=$1
  echo "  $testcase"
  if make TESTCASE="$testcase" diss; then
    echo "PASS: $testcase"
  else
    echo "FAIL: $testcase"
    failures+=("$testcase")
  fi
}
run_case mgather_fp16_16x16
run_case mgather_fp32_16x16
run_case mgather_i32_16x16
run_case mscatter_fp16_16x16
run_case mscatter_fp32_16x16
run_case mscatter_i32_16x16
run_case tload_fp16_16x16
run_case tload_fp16_32x32
run_case tload_fp32_16x16
run_case tload_fp32_32x32
run_case tload_i32_16x16
run_case tstore_fp16_16x16
run_case tstore_fp32_16x16
run_case tstore_i32_16x16
if [ "${#failures[@]}" -ne 0 ]; then
  echo "=== memory FAILED: ${failures[*]} ==="
  exit 1
fi
echo "=== memory completed: all 14 cases passed ==="
